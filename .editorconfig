# Top-most EditorConfig file
root = true

###############################
# Base settings (all files)   #
###############################
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

[*.{json,yml,yaml,xml,csproj,props,targets,sln,config}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

################################
# C# style & analyzers         #
################################
[*.cs]

# Modern C# style (suggestion = shown in IDE, not enforced at build)
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_prefer_static_local_function = true:suggestion
csharp_preserve_single_line_blocks = true:suggestion
csharp_preserve_single_line_statements = false:suggestion
csharp_prefer_braces = true

# Using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_using_directive_placement = outside_namespace:suggestion

# .NET style (suggestion = shown in IDE, not enforced at build)
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:suggestion
dotnet_style_prefer_foreach_explicit_cast_in_source = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_prefer_simplified_interpolation = true:suggestion
dotnet_style_prefer_inferred_tuple_names = true:suggestion
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion
dotnet_style_prefer_collection_initializer = true:suggestion
dotnet_style_prefer_object_initializer = true:suggestion
dotnet_style_prefer_coalesce_expression = true:suggestion
dotnet_style_prefer_null_propagation = true:suggestion
dotnet_style_prefer_explicit_tuple_names = true:suggestion
dotnet_code_quality_unused_parameters = all:suggestion

# Enforced at build (warning -> error via TreatWarningsAsErrors)
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0005.severity = warning          # Remove unnecessary using directives
dotnet_diagnostic.IDE0011.severity = warning          # Add braces
dotnet_diagnostic.IDE0036.severity = warning          # Order modifiers
dotnet_diagnostic.IDE0130.severity = warning          # Namespace matches folder structure
dotnet_diagnostic.IDE0161.severity = warning          # Use file-scoped namespace
dotnet_diagnostic.IDE0240.severity = warning          # Remove redundant nullable directives

# Naming conventions (suggestion = shown in IDE, not enforced at build)
dotnet_naming_rule.interfaces_should_begin_with_i.severity = suggestion
dotnet_naming_rule.interfaces_should_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_begin_with_i.style = begins_with_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate, record, record_struct
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case_style
dotnet_naming_symbols.non_field_members.applicable_kinds = property, method, event, local_function
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_should_begin_with_underscore.severity = suggestion
dotnet_naming_rule.private_fields_should_begin_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_begin_with_underscore.style = underscore_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal, protected, protected_internal, private_protected
dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case

dotnet_naming_rule.constants_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case_style
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.locals_and_parameters_should_be_camel_case.severity = suggestion
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.style = camel_case_style
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_style.camel_case_style.capitalization = camel_case

# No file header is required (kept explicit so StyleCop SA1633 stays off)
file_header_template = unset

# CA1711: 'Permission' is the domain term for an application capability — the authorization
# model, permission catalog and documentation all speak of permissions. The reserved-suffix
# rule (which reserves 'Permission' for System.Security.IPermission types) is therefore
# relaxed for this suffix only, as the rule's guidance permits for unambiguous domain terms.
dotnet_code_quality.ca1711.allowed_suffixes = Permission

# StyleCop: we deliberately do not use file headers (see stylecop.json)
dotnet_diagnostic.SA1633.severity = none
# StyleCop: conflicts with repo conventions above (dotnet_style_qualification_* = false)
dotnet_diagnostic.SA1101.severity = none
# StyleCop: conflicts with repo private-field naming (underscore prefix)
dotnet_diagnostic.SA1309.severity = none

# Test files: underscore-separated method names are conventional for xunit tests
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
