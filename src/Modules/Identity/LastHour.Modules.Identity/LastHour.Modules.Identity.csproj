<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EF Core is referenced only for the module-owned entity configuration
    (Persistence/UserConfiguration.cs); Relational provides the mapping extension methods
    (ToTable, HasColumnName, HasIndex). No domain type in this module references EF Core;
    the mapping is discovered by the shared DbContext through ApplyConfigurationsFromAssembly.
  -->
  <ItemGroup>
    <!--
      Microsoft.Extensions.* packages support the module's application services: options
      binding and startup validation for the password policy, and the DI extension.
      FluentValidation powers the registration command validator, consumed by the shared
      validation pipeline behavior; logging is used for safe registration events.
    -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\LastHour.BuildingBlocks.Application\LastHour.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\LastHour.BuildingBlocks.Architecture\LastHour.BuildingBlocks.Architecture.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\LastHour.BuildingBlocks.SharedKernel\LastHour.BuildingBlocks.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\LastHour.BuildingBlocks.Contracts\LastHour.BuildingBlocks.Contracts.csproj" />
  </ItemGroup>

</Project>
