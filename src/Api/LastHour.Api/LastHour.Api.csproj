    <ProjectReference Include="..\..\Modules\Administration\LastHour.Modules.Administration\LastHour.Modules.Administration.csproj" />
    <ProjectReference Include="..\..\Modules\Analytics\LastHour.Modules.Analytics\LastHour.Modules.Analytics.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\LastHour.Modules.Catalog\LastHour.Modules.Catalog.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\LastHour.Modules.Identity\LastHour.Modules.Identity.csproj" />
