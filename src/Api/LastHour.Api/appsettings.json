{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Process",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Diagnostics.HealthChecks": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/last-hour-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=last_hour;Username=last_hour;Password=last_hour"
  },
  "Outbox": {
    "Enabled": true,
    "ProcessingInterval": "00:00:15",
    "BatchSize": 100,
    "MaxRetryCount": 10
  },
  "PasswordPolicy": {
    "MinimumLength": 12,
    "MaximumLength": 128
  },
  "PasswordHashing": {
    "TimeCost": 3,
    "MemoryCost": 65536,
    "Lanes": 4,
    "Threads": 4,
    "HashLength": 32,
    "SaltLength": 16
  },
  "AccountSecurity": {
    "MaxFailedAttempts": 5,
    "LockoutDuration": "00:15:00"
  },
  "Jwt": {
    "Issuer": "https://lasthour.dev",
    "Audience": "lasthour-api",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "ClockSkew": "00:01:00"
  },
  "RefreshToken": {
    "Lifetime": "14.00:00:00"
  },
  "DatabaseInitializer": {
    "Enabled": true
  },
  "HealthChecks": {
    "TimeoutSeconds": 5,
    "Redis": {
      "ConnectionString": ""
    },
    "Disk": {
      "Path": "",
      "MinimumFreeMegabytes": 512
    },
    "Memory": {
      "MaximumUsedBytes": 1073741824
    },
    "Outbox": {
      "WarningPendingMessageCount": 50,
      "CriticalPendingMessageCount": 500,
      "WarningOldestMessageAge": "00:02:00",
      "CriticalOldestMessageAge": "00:10:00",
      "ProcessorHeartbeatTimeout": "00:01:00"
    }
  },
  "Cqrs": {
    "Performance": {
      "SlowRequestThreshold": "00:00:01"
    }
  },
  "ResponseCompression": {
    "Enabled": true,
    "EnableForHttps": true,
    "CompressionLevel": "SmallestSize",
    "MimeTypes": [ "application/problem+json" ]
  },
  "Cors": {
    "Enabled": true,
    "AllowAnyOrigin": false,
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Secrets": {
    "Enabled": true,
    "EnvironmentVariablePrefix": "LASTHOUR_SECRET_",
    "Names": [ "ConnectionStrings:Postgres", "Jwt:SigningKey" ]
  },
  "RequestLimits": {
    "Enabled": true,
    "MaxRequestBodySize": 10485760,
    "RequestHeadersTimeout": "00:00:30",
    "KeepAliveTimeout": "00:02:10",
    "MultipartBodyLengthLimit": 134217728,
    "MinRequestBodyDataRateBytesPerSecond": 240.0,
    "MinRequestBodyDataRateGracePeriod": "00:00:05"
  },
  "AuditLogging": {
    "Enabled": true,
    "FilePath": "logs/last-hour-audit-.log",
    "RetainedFileCount": 30
  },
  "OpenTelemetry": {
    "Enabled": true,
    "TracingEnabled": true,
    "MetricsEnabled": true,
    "ConsoleExporterEnabled": false,
    "UseOtlpExporter": false,
    "OtlpEndpoint": "",
    "ServiceName": "LastHour.Api",
    "ServiceVersion": ""
  },
  "OutputCache": {
    "Enabled": true,
    "UseCaseSensitivePaths": false,
    "Profiles": [
      {
        "Name": "Default",
        "DurationSeconds": 60,
        "VaryByQueryKeys": [ "*" ],
        "Tags": [ "default" ]
      }
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "RejectionStatusCode": 429,
    "GlobalPolicyName": "Global",
    "Policies": [
      {
        "Name": "Global",
        "Algorithm": "FixedWindow",
        "PartitionBy": "Global",
        "PermitLimit": 120,
        "WindowSeconds": 60,
        "QueueLimit": 0,
        "AutoReplenishment": true
      },
      {
        "Name": "SystemStatus",
        "Algorithm": "SlidingWindow",
        "PartitionBy": "IpAddress",
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 2,
        "QueueLimit": 0,
        "AutoReplenishment": true
      }
    ]
  }
}
