<Project>

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <!--
    Properties applied to every project under tests/.
    Test projects are never shipped or packed.
  -->

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Shared test-stack package: every test project gets the fluent assertion library
    via the central version table (Directory.Packages.props).
  -->

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

</Project>
